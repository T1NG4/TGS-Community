{
  "name": "tgs-launcher",
  "version": "2.0.29",
  "description": "Launcher para FiveM - Gerenciador de Mods com Catálogo Visual e Autenticação Segura",
  "main": "main-new.js",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "build": "vite build",
    "package": "electron-builder --win",
    "package:win": "electron-builder --win"
  },
  "keywords": [
    "fivem",
    "launcher",
    "gaming",
    "electron"
  ],
  "author": "TGS",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "electron-updater": "^6.1.8",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1"
  },
  "devDependencies": {
    "electron": "^24.0.0",
    "electron-builder": "^23.6.0",
    "vite": "^4.3.9",
    "vite-plugin-electron": "^0.10.4"
  },
  "build": {
    "appId": "com.tgs.launcher",
    "productName": "Launcher",
    "copyright": "Copyright 2023 TGS",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "midias/TGS/TGS_logo.ico",
      "publisherName": "TGS",
      "publish": [
        {
          "provider": "github",
          "owner": "T1NG4",
          "repo": "TGS-mod-manager-releases"
        }
      ]
    },
    "portable": {
      "artifactName": "TGS-Mod-Manager-Portable.exe"
    }
  }
}
