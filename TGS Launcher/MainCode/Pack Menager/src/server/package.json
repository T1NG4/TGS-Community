{
  "name": "fivem-car-pack-server",
  "version": "1.0.0",
  "description": "Backend engine for FiveM Car Pack Manager",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pack-template": "node src/__tests__/vehicles-pack-template.run.js",
    "test:pack-merge": "node src/__tests__/vehicles-pack-merge.run.js",
    "test:run": "vitest run && npm run test:pack-template && npm run test:pack-merge"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.18.2",
    "express-rate-limit": "^8.4.1",
    "fs-extra": "^11.3.4",
    "multer": "^2.1.1",
    "sanitize-filename": "^1.6.4",
    "winston": "^3.19.0",
    "xml2js": "^0.6.2",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "vitest": "^3.2.4"
  },
  "bin": "src/index.js",
  "pkg": {
    "assets": [
      "../client/dist/**/*"
    ]
  }
}
