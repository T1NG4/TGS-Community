// Create key card
function createKeyCard(key, modsData) {
    const card = document.createElement('div');
    card.className = 'key-card';
    
    // Check if key is expired
    const isExpired = key.expiryDate && new Date(key.expiryDate) < new Date();
    const status = isExpired ? 'expired' : key.status;
    
    // Format dates
    const purchaseDate = new Date(key.purchaseDate).toLocaleDateString('pt-BR');
    const expiryDate = key.isLifetime 
        ? '<span class="lifetime">LIFETIME</span>' 
        : new Date(key.expiryDate).toLocaleDateString('pt-BR');
    
    // Count resources
    const resourceCounts = {};
    if (key.resources) {
        Object.keys(key.resources).forEach(category => {
            const resources = key.resources[category];
            if (resources.includes('all')) {
                // Count all mods in this category
                const categoryMods = modsData?.filter(mod => 
                    mod.category.toLowerCase() === category.toLowerCase()
                ) || [];
                resourceCounts[category] = categoryMods.length || 'Todos';
            } else {
                resourceCounts[category] = resources.length;
            }
        });
    }
    
    // Build resource list HTML
    let resourcesHTML = '';
    if (key.resources) {
        Object.keys(key.resources).forEach(category => {
            const categoryLabels = {
                'maps': 'Mapas',
                'weapons': 'Armas',
                'vehicles': 'Veículos',
                'scripts': 'Scripts',
                'graphics': 'Gráficos'
            };
            
            const categoryIcons = {
                'maps': 'fa-map',
                'weapons': 'fa-gun',
                'vehicles': 'fa-car',
                'scripts': 'fa-code',
                'graphics': 'fa-palette'
            };
            
            const label = categoryLabels[category] || category;
            const icon = categoryIcons[category] || 'fa-cube';
            const count = resourceCounts[category];
            
            resourcesHTML += `
                <div class="resource-item">
                    <span class="resource-name">
                        <i class="fas ${icon}"></i>
                        ${label}
                    </span>
                    <span class="resource-count">${count}</span>
                </div>
            `;
        });
    }
    
    card.innerHTML = `
        <div class="key-header">
            <div class="key-code">${key.keyCode}</div>
            <div class="key-status ${status}">
                <i class="fas ${isExpired ? 'fa-times-circle' : 'fa-check-circle'}"></i>
                ${isExpired ? 'Expirada' : 'Ativa'}
            </div>
        </div>
        
        <div class="key-resources">
            <h4>Recursos Disponíveis</h4>
            <div class="resource-list">
                ${resourcesHTML || '<p style="color: var(--text-secondary); font-size: 0.9rem;">Nenhum recurso associado</p>'}
            </div>
        </div>
        
        <div class="key-dates">
            <div class="key-date">
                <span class="key-date-label">Data de Compra:</span>
                <span class="key-date-value">${purchaseDate}</span>
            </div>
            <div class="key-date">
                <span class="key-date-label">${key.isLifetime ? 'Validade:' : 'Expira em:'}</span>
                <span class="key-date-value ${key.isLifetime ? 'lifetime' : ''}">${expiryDate}</span>
            </div>
        </div>
    `;
    
    return card;
}

// Filter mods based on user's key resources
function filterModsByUserAccess(mods, userKeys) {
    if (!userKeys || userKeys.length === 0) {
        return []; // No access
    }
    
    const accessibleModIds = new Set();
    
    userKeys.forEach(key => {
        if (key.status === 'active' && key.resources) {
            Object.keys(key.resources).forEach(category => {
                const resources = key.resources[category];
                if (resources.includes('all')) {
                    // Add all mods from this category
                    mods.filter(mod => mod.category.toLowerCase() === category.toLowerCase())
                        .forEach(mod => accessibleModIds.add(mod.id));
                } else {
                    // Add specific mod IDs
                    resources.forEach(modId => accessibleModIds.add(modId));
                }
            });
        }
    });
    
    return mods.filter(mod => accessibleModIds.has(mod.id));
}

// Show access denied modal
function showAccessDeniedModal(mod, errorMessage = '') {
    const modal = document.getElementById('accessDeniedModal');
    const messageElement = document.getElementById('accessDeniedMessage');
    const purchaseBtn = document.getElementById('purchaseModBtn');
    const closeBtn = document.getElementById('closeModalBtn');

    if (!modal || !messageElement) {
        showNotification('Erro ao verificar acesso ao mod', 'error');
        return;
    }

    // Customize message based on mod and error
    let customMessage = `O mod "${mod.name}" não está disponível na chave de acesso que você está usando no momento.`;
    if (errorMessage) {
        customMessage += ` ${errorMessage}`;
    }

    messageElement.textContent = customMessage;

    // Show modal
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';

    // Setup event listeners
    const closeModal = () => {
        modal.style.display = 'none';
        document.body.style.overflow = '';
    };

    closeBtn.onclick = closeModal;

    purchaseBtn.onclick = () => {
        // Handle purchase redirect
        handleModPurchase(mod);
        closeModal();
    };

    // Close on overlay click
    modal.onclick = (e) => {
        if (e.target === modal) {
            closeModal();
        }
    };

    // Close on Escape key
    document.addEventListener('keydown', function escapeHandler(e) {
        if (e.key === 'Escape') {
            closeModal();
            document.removeEventListener('keydown', escapeHandler);
        }
    });
}

