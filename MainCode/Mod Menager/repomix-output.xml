        } catch (error) {
            console.error('Erro ao iniciar o FiveM:', error);
            showNotification(`Erro: ${error.message}`, 'error');
        } finally {
            // Re-enable button
            launchBtn.disabled = false;
            launchBtn.innerHTML = '<i class="fas fa-play"></i> Iniciar FiveM';
        }
    }
}

// Helper function to show notifications
function showNotification(message, type = 'info') {
    // In a real app, you might want to use a proper notification system
    // For now, we'll use a simple alert or console log
    console.log(`[${type.toUpperCase()}] ${message}`);
    
    // You can customize this to show a nice notification UI
    const notification = document.createElement('div');
    notification.className = `notification ${type}`;
    notification.textContent = message;
    
    // Add to the page (you can style this in your CSS)
    document.body.appendChild(notification);
    
    // Remove after some time
    setTimeout(() => {
        notification.classList.add('fade-out');
        setTimeout(() => notification.remove(), 300);
    }, 3000);
}

// Add some global error handling
window.addEventListener('error', function(error) {
    console.error('Global error:', error);
    showNotification(`Ocorreu um erro: ${error.message}`, 'error');
});
