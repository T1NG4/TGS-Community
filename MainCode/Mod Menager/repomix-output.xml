<file path="main-new.js">
const { app, BrowserWindow, ipcMain } = require('electron');
const path = require('path');
const fs = require('fs').promises;
const { exec } = require('child_process');
const { promisify } = require('util');
const execAsync = promisify(exec);

let mainWindow;
const APP_DATA_PATH = path.join(app.getPath('userData'), 'Launcher');
const LOGS_PATH = path.join(APP_DATA_PATH, 'logs');
const MODS_STATE_PATH = path.join(APP_DATA_PATH, 'mods-state.json');

// Criar diretórios necessários
async function ensureDirectories() {
    try {
        await fs.mkdir(APP_DATA_PATH, { recursive: true });
        await fs.mkdir(LOGS_PATH, { recursive: true });
        console.log('Diretórios criados/verificados com sucesso');
    } catch (error) {
        console.error('Erro ao criar diretórios:', error);
    }
}

function createWindow() {
    mainWindow = new BrowserWindow({
        width: 1200,
        height: 800,
        minWidth: 900,
        minHeight: 600,
        webPreferences: {
            nodeIntegration: true,
            contextIsolation: false,
            enableRemoteModule: true
        },
        frame: false,
        titleBarStyle: 'hidden',
        backgroundColor: '#1a1a2e',
        icon: path.join(__dirname, 'midias', 'TGS', 'TGS_logo.ico')
    });

    mainWindow.loadFile('login.html');

    // Descomente para desenvolvimento
    // mainWindow.webContents.openDevTools();

    mainWindow.on('closed', function () {
        mainWindow = null;
    });
}

app.whenReady().then(async () => {
    await ensureDirectories();
    createWindow();

    app.on('activate', function () {
        if (BrowserWindow.getAllWindows().length === 0) createWindow();
    });
});

app.on('window-all-closed', function () {
    if (process.platform !== 'darwin') app.quit();
});

// ===== WINDOW CONTROLS =====
ipcMain.on('minimize-window', () => {
    if (mainWindow) mainWindow.minimize();
});

ipcMain.on('maximize-window', () => {
    if (mainWindow) {
        if (mainWindow.isMaximized()) {
            mainWindow.unmaximize();
        } else {
            mainWindow.maximize();
        }
    }
});

ipcMain.on('close-window', () => {
    if (mainWindow) mainWindow.close();
});

// ===== AUTHENTICATION =====
ipcMain.handle('validate-auth', async (event, { accessKey, username, password }) => {
    try {
        // Try new users-keys-config.json first
        const usersKeysConfigPath = path.join(__dirname, 'users-keys-config.json');
        try {
            const usersData = await fs.readFile(usersKeysConfigPath, 'utf-8');
            const usersConfig = JSON.parse(usersData);

            const user = usersConfig.users.find(u => 
                u.username === username && 
                u.password === password &&
                u.active === true
            );

            if (user) {
                // Check if user has the access key
                const hasKey = user.keys.some(k => k.keyCode === accessKey && k.status === 'active');
                if (hasKey) {
                    await logEvent('AUTH', `Usuário ${username} autenticado com sucesso`);
                    return { success: true, role: user.role, username: user.username };
                } else {
                    await logEvent('AUTH', `Chave inválida para usuário: ${username}`);
                    return { success: false, error: 'Chave de acesso inválida' };
                }
            }
        } catch (err) {
            // Fall back to old auth-config.json
            const authConfigPath = path.join(__dirname, 'auth-config.json');
            const authData = await fs.readFile(authConfigPath, 'utf-8');
            const authConfig = JSON.parse(authData);

            const user = authConfig.users.find(u => 
                u.key === accessKey && 
                u.username === username && 
                u.password === password &&
                u.active === true
            );

            if (user) {
                await logEvent('AUTH', `Usuário ${username} autenticado com sucesso`);
                return { success: true, role: user.role, username: user.username };
            }
        }

        await logEvent('AUTH', `Tentativa de login falhou para: ${username}`);
        return { success: false, error: 'Credenciais inválidas' };
    } catch (error) {
        console.error('Erro na autenticação:', error);
        await logEvent('ERROR', `Erro na autenticação: ${error.message}`);
        return { success: false, error: 'Erro ao validar credenciais' };
    }
});

// ===== USER PROFILE =====
ipcMain.handle('get-user-profile', async (event, { username, accessKey }) => {
    try {
        const usersKeysConfigPath = path.join(__dirname, 'users-keys-config.json');
        const usersData = await fs.readFile(usersKeysConfigPath, 'utf-8');
        const usersConfig = JSON.parse(usersData);

        const user = usersConfig.users.find(u => u.username === username && u.active === true);

        if (user) {
            return user;
        }

        return null;
    } catch (error) {
        console.error('Erro ao carregar perfil:', error);
        await logEvent('ERROR', `Erro ao carregar perfil: ${error.message}`);
        return null;
    }
});

// ===== MODS MANAGEMENT =====
ipcMain.handle('load-mods', async (event) => {
    try {
        const modsConfigPath = path.join(__dirname, 'mods-config.json');
        const modsData = await fs.readFile(modsConfigPath, 'utf-8');
        const modsConfig = JSON.parse(modsData);

        // Load saved state
        try {
            const stateData = await fs.readFile(MODS_STATE_PATH, 'utf-8');
            const state = JSON.parse(stateData);
            
            // Apply saved state
            modsConfig.mods.forEach(mod => {
                const savedMod = state.mods.find(m => m.id === mod.id);
                if (savedMod) {
                    mod.enabled = savedMod.enabled;
                }
            });
        } catch (error) {
            // No saved state, use defaults
            console.log('Nenhum estado salvo encontrado, usando padrões');
        }

        // Update category counts
        modsConfig.categories.forEach(cat => {
            if (cat.name === 'All') {
                cat.count = modsConfig.mods.length;
            } else {
                cat.count = modsConfig.mods.filter(mod => mod.category === cat.name).length;
            }
        });

        return modsConfig;
    } catch (error) {
        console.error('Erro ao carregar mods:', error);
        await logEvent('ERROR', `Erro ao carregar mods: ${error.message}`);
        throw error;
    }
});

// ===== MOD ACCESS VERIFICATION =====
ipcMain.handle('check-mod-access', async (event, { username, accessKey, modId }) => {
    try {
        const usersKeysConfigPath = path.join(__dirname, 'users-keys-config.json');
        const usersData = await fs.readFile(usersKeysConfigPath, 'utf-8');
        const usersConfig = JSON.parse(usersData);

        const user = usersConfig.users.find(u => u.username === username && u.active === true);

        if (!user) {
            return { hasAccess: false, error: 'Usuário não encontrado' };
        }

        // Check if user has the access key and it's active
        const userKey = user.keys.find(k => k.keyCode === accessKey && k.status === 'active');

        if (!userKey) {
            return { hasAccess: false, error: 'Chave de acesso inválida ou inativa' };
        }

        // Check if key is expired
        if (userKey.expiryDate && new Date(userKey.expiryDate) < new Date() && !userKey.isLifetime) {
            return { hasAccess: false, error: 'Chave de acesso expirada' };
        }

        // Check if mod is accessible via this key
        if (!userKey.resources) {
            return { hasAccess: false, error: 'Nenhum recurso disponível nesta chave' };
        }

        // Get mod category from mods-config.json
        const modsConfigPath = path.join(__dirname, 'mods-config.json');
        const modsData = await fs.readFile(modsConfigPath, 'utf-8');
        const modsConfig = JSON.parse(modsData);

        const mod = modsConfig.mods.find(m => m.id === modId);
        if (!mod) {
            return { hasAccess: false, error: 'Mod não encontrado' };
        }

        // Check access based on mod category
        const modCategory = mod.category.toLowerCase();
        const categoryMapping = {
            'graphics': 'graphics',
            'weapons': 'weapons',
            'vehicles': 'vehicles',
            'maps': 'maps',
            'audio': 'scripts',
            'performance': 'scripts'
        };

        const resourceCategory = categoryMapping[modCategory] || 'scripts';

        if (userKey.resources[resourceCategory]) {
            const resources = userKey.resources[resourceCategory];

            // Check if user has access to all resources in this category
            if (resources.includes('all')) {
                return { hasAccess: true };
            }

            // Check if user has access to this specific mod
            if (resources.includes(modId)) {
                return { hasAccess: true };
            }
        }

        await logEvent('ACCESS', `Tentativa de acesso negada ao mod ${mod.name} (${modId}) para usuário ${username}`);
        return { hasAccess: false, error: 'Recurso não disponível nesta chave de acesso' };

    } catch (error) {
        console.error('Erro ao verificar acesso ao mod:', error);
        await logEvent('ERROR', `Erro ao verificar acesso ao mod: ${error.message}`);
        return { hasAccess: false, error: 'Erro ao verificar acesso' };
    }
});

// ===== FIVEM LAUNCH =====
ipcMain.handle('launch-fivem-with-mods', async (event, { mods }) => {
    try {
        await logEvent('LAUNCH', `Iniciando FiveM com ${mods.length} mod(s)`);

        // Log dos mods ativados
        mods.forEach(mod => {
            logEvent('LAUNCH', `- Mod ativo: ${mod.name} (${mod.version})`);
        });

        // Aplicar mods (simulação - você precisará implementar a lógica real)
        await applyMods(mods);

        // Encontrar e iniciar o FiveM
        const fivemPath = await findFiveMPath();
        
        if (!fivemPath) {
            throw new Error('FiveM não encontrado. Instale o FiveM e tente novamente.');
        }

        // Iniciar FiveM
        await execAsync(`"${fivemPath}"`);
        
        await logEvent('LAUNCH', 'FiveM iniciado com sucesso');
        return { success: true };

    } catch (error) {
        console.error('Erro ao iniciar FiveM:', error);
        await logEvent('ERROR', `Erro ao iniciar FiveM: ${error.message}`);
        return { success: false, error: error.message };
    }
});

// Função para aplicar mods
async function applyMods(mods) {
    try {
        // Obter o caminho do FiveM Application Data
        const fivemAppData = path.join(
            process.env.LOCALAPPDATA || process.env.APPDATA,
            'FiveM',
            'FiveM Application Data'
        );

        await logEvent('MOD', `Aplicando mods em: ${fivemAppData}`);

        // Para cada mod ativo, copiar/aplicar os arquivos
        for (const mod of mods) {
            try {
                const modPath = path.join(__dirname, mod.path);
                const targetPath = path.join(fivemAppData, 'plugins', mod.id);

                // Verificar se o mod existe
                try {
                    await fs.access(modPath);
                    // Copiar mod para o diretório do FiveM
                    // Nota: Você precisará implementar a lógica de cópia
                    await logEvent('MOD', `Mod ${mod.name} aplicado com sucesso`);
                } catch {
                    await logEvent('WARNING', `Mod ${mod.name} não encontrado em ${modPath}`);
                }
            } catch (error) {
                await logEvent('ERROR', `Erro ao aplicar mod ${mod.name}: ${error.message}`);
            }
        }

        return { success: true };
    } catch (error) {
        console.error('Erro ao aplicar mods:', error);
        throw error;
    }
}

// Função para encontrar o caminho do FiveM
async function findFiveMPath() {
    const possiblePaths = [
        path.join(process.env.LOCALAPPDATA, 'FiveM', 'FiveM.exe'),
        'C:\\Program Files\\FiveM\\FiveM.exe',
        'C:\\Program Files (x86)\\FiveM\\FiveM.exe',
        path.join(process.env.APPDATA, 'FiveM', 'FiveM.exe')
    ];

    for (const fivemPath of possiblePaths) {
        try {
            await fs.access(fivemPath);
            await logEvent('INFO', `FiveM encontrado em: ${fivemPath}`);
            return fivemPath;
        } catch {
            continue;
        }
    }

    return null;
}

// ===== LOGGING SYSTEM =====
ipcMain.on('log-event', async (event, { type, message, timestamp }) => {
    await logEvent(type, message);
});

ipcMain.handle('get-logs', async (event, options = {}) => {
    try {
        const { limit = 50, filter } = options;

        // Get all log files
        const logFiles = await fs.readdir(LOGS_PATH);
        const logFilesFiltered = logFiles.filter(file => file.endsWith('.log')).sort().reverse();

        let allLogs = [];

        for (const logFile of logFilesFiltered.slice(0, 7)) { // Last 7 days
            try {
                const filePath = path.join(LOGS_PATH, logFile);
                const content = await fs.readFile(filePath, 'utf-8');
                const lines = content.trim().split('\n').filter(line => line.trim());

                const parsedLogs = lines.map(line => {
                    const match = line.match(/^\[([^\]]+)\] \[([^\]]+)\] (.+)$/);
                    if (match) {
                        return {
                            timestamp: match[1],
                            type: match[2],
                            message: match[3]
                        };
                    }
                    return null;
                }).filter(log => log !== null);

                allLogs = allLogs.concat(parsedLogs);
            } catch (error) {
                console.error(`Error reading log file ${logFile}:`, error);
            }
        }

        // Apply filter if specified
        if (filter && filter !== 'all') {
            allLogs = allLogs.filter(log => log.type.toLowerCase() === filter.toLowerCase());
        }

        // Sort by timestamp (newest first)
        allLogs.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));

        // Apply limit
        return allLogs.slice(0, limit);
    } catch (error) {
        console.error('Error getting logs:', error);
        return [];
    }
});

async function logEvent(type, message) {
    try {
        const timestamp = new Date().toISOString();
        const logEntry = `[${timestamp}] [${type}] ${message}\n`;
        
        // Log no console
        console.log(logEntry.trim());

        // Salvar em arquivo
        const today = new Date().toISOString().split('T')[0];
        const logFile = path.join(LOGS_PATH, `${today}.log`);
        
        await fs.appendFile(logFile, logEntry, 'utf-8');
    } catch (error) {
        console.error('Erro ao registrar log:', error);
    }
}

// ===== SETTINGS =====
ipcMain.on('save-settings', async (event, settings) => {
    try {
        const settingsPath = path.join(APP_DATA_PATH, 'settings.json');
        await fs.writeFile(settingsPath, JSON.stringify(settings, null, 2));
        await logEvent('SETTINGS', 'Configurações salvas com sucesso');
    } catch (error) {
        console.error('Erro ao salvar configurações:', error);
        await logEvent('ERROR', `Erro ao salvar configurações: ${error.message}`);
    }
});

// Função de limpeza ao fechar o app
app.on('before-quit', async () => {
    await logEvent('SYSTEM', 'Aplicação fechada');
});

console.log('Launcher iniciado');
