        (function(){
            try {
                // Se estivermos no Electron, require funciona
                if (typeof require === 'function') {
                    window.electron = require('electron');
                    window.ipcRenderer = window.electron.ipcRenderer;
                } else {
                    throw new Error('require não disponível');
                }
            } catch (err) {
                // Fallback leve para o navegador — mocks que registram chamadas
                console.warn('Electron não detectado, usando mocks para desenvolvimento web.');
                window.electron = null;
                window.ipcRenderer = {
                    invoke: async (channel, args) => {
                        console.debug('[ipc.invoke fallback]', channel, args);
                        // Retornos mínimos usados pelo app
                        if (channel === 'load-mods') {
                            try {
                                const res = await fetch('mods-config.json');
                                return await res.json();
                            } catch (e) { return { mods: [], categories: [] }; }
                        }
                        if (channel === 'validate-auth') {
                            // simple local dev auth
                            return { success: args.accessKey === 'TGS-2024-PREMIUM-001' && args.username === 'admin' && args.password === 'TGS_pedro2004', role: 'admin' };
                        }
                        if (channel === 'toggle-mod') return { success: true };
                        if (channel === 'launch-fivem-with-mods') return { success: true };
                        return {};
                    },
                    send: (channel, args) => {
                        console.debug('[ipc.send fallback]', channel, args);
                    }
                };
            }
        })();
    </script>
