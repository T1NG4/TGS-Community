{
  "name": "tgs-launcher",
  "version": "2.0.2",
  "description": "Launcher de instalação e Hub para TGS Ecosystem",
  "repository": {
    "type": "git",
    "url": "https://github.com/T1NG4/tgs-launcher.git"
  },
  "main": "src/main/main.js",
  "author": "TGS",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "electron src/main/main.js",
    "dev:renderer": "vite",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "crypto-js": "^4.2.0",
    "electron-is-dev": "^2.0.0",
    "electron-updater": "^6.1.8",
    "js-yaml": "^4.1.0",
    "winston": "^3.11.0",
    "clsx": "2.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/crypto-js": "^4.2.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "lucide-react": "^1.14.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  },
  "build": {
    "appId": "com.tgs.launcher",
    "productName": "TGS Launcher",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "package.json",
      "src/main/**/*",
      "dist-renderer/**/*",
      "!**/*.map"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "T1NG4",
        "repo": "TGS-launcher-releases",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "resources/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "resources/icons/icon.ico",
      "uninstallerIcon": "resources/icons/icon.ico",
      "installerHeaderIcon": "resources/icons/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TGS Launcher"
    }
  }
}
